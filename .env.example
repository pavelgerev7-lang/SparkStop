# SparkDrop Environment Configuration

# Server Options
PORT=3000
NODE_ENV=development

# Signs session tokens (including admin login). Without this, a random
# secret is generated per process start and every session is invalidated on
# restart/deploy. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string — currently a free Neon (neon.tech) database.
# Without this set, the app falls back to a local JSON file (data/local_db.json)
# for everything (users, saved addresses, outages), which is fine for local
# dev but risks real data loss in production (free-tier hosts like Render
# don't guarantee a persistent disk across deploys/restarts). Apply
# schema.sql to a fresh database before pointing this at it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API Key (for AI Parser)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend (resend.com) transactional email API for real registration/
# password-reset verification codes. Uses HTTPS, not SMTP — Render (like
# most PaaS free tiers) blocks outbound SMTP ports to prevent abuse, which
# made an earlier Gmail-SMTP-based version hang forever in production while
# working fine locally. Without RESEND_API_KEY set, verification codes are
# shown directly in the UI instead of emailed (fine for local dev, not for
# a real public launch). RESEND_SENDER_EMAIL must be on a domain verified in
# your Resend account; defaults to contact@sparkstopapp.com if unset.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=contact@sparkstopapp.com

# Firebase Cloud Messaging (FCM) Credentials (JSON String or Path)
# If omitted, system runs in simulated push notification mode.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sparkdrop-bg",...}

# Scraper Interval (Cron Expression - Default: every 15 mins)
SCRAPER_CRON_SCHEDULE=*/15 * * * *

# Quiet hours: between these hours (Sofia time, end excluded) the scraper, the integrity sweep and the
# retention job do not start, so the Neon database has nothing to do and can suspend (it is billed per
# awake hour). Visitors are still served. "1-6" = 01:00 to 06:00, "23-5" wraps past midnight, "off" = never pause.
QUIET_HOURS=1-6
